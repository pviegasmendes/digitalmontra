---
import { tx } from '../scripts/render.js';
import { CONTACT_EMAIL } from '../data/contact.js';
---
<footer class="site-footer">
  <div class="wrap footer-cta">
    <p class="footer-lead" data-i18n="footer.lead">{tx('footer.lead')}</p>
    <a class="footer-mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </div>
  <div class="wrap footer-inner">
    <div class="brand brand-light">
      <img src="/assets/emblem-white.png" alt="" width="44" height="44">
      <span>DIGITAL MONTRA<small>WEB STUDIO</small></span>
    </div>
    <nav class="footer-links" aria-label="Rodapé">
      <a href="#servicos" data-i18n="nav.services">{tx('nav.services')}</a>
      <a href="#processo" data-i18n="nav.process">{tx('nav.process')}</a>
      <a href="#planos" data-i18n="nav.plans">{tx('nav.plans')}</a>
      <a href="#contacto" data-i18n="nav.contact">{tx('nav.contact')}</a>
    </nav>
    <div class="footer-legal">
      <p>© <span id="year">2026</span> Digital Montra Web Studio, Algarve, Portugal</p>
      <p class="footer-legal-links">
        <a href="/politica-de-privacidade" data-i18n="cookie.policy">{tx('cookie.policy')}</a>
        <button type="button" class="link-btn" data-cookie-settings data-i18n="cookie.settings">{tx('cookie.settings')}</button>
      </p>
    </div>
  </div>
</footer>
