---
import { tx, list } from '../scripts/render.js';
---
<!-- FAQ: título fixo à esquerda, perguntas à direita -->
<section id="faq" class="wrap section">
  <div class="faq-grid">
    <h2 data-i18n="faq.title" data-reveal>{tx('faq.title')}</h2>
    <div class="faq" data-list="faq.items" set:html={list('faq.items')}></div>
  </div>
</section>
