---
import { tx, list } from '../scripts/render.js';
---
<!-- PROCESSO: quatro passos numerados e o painel do rascunho -->
    <section id="processo" class="wrap section">
      <header class="section-head" data-reveal>
        <h2 data-i18n="process.title">{tx('process.title')}</h2>
      </header>
      <ol class="grid steps" data-list="process.steps" set:html={list('process.steps')}></ol>

      <div class="draft" data-reveal>
        <div class="draft-copy">
          <h3 data-i18n="draft.title">{tx('draft.title')}</h3>
          <p data-i18n="draft.text">{tx('draft.text')}</p>
          <a class="btn btn-primary" href="#contacto" data-i18n="hero.cta1">{tx('hero.cta1')}</a>
        </div>
        <div class="draft-stage" aria-hidden="true">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span class="browser-url">o-seu-negocio.pt</span></div>
            <div class="browser-body">
              <div class="sk-nav"><span class="sk-logo"></span><span class="sk-bar" style="width:14%"></span><span class="sk-bar" style="width:11%"></span><span class="sk-bar" style="width:13%"></span></div>
              <div class="sk-hero">
                <div class="sk-lines">
                  <span class="sk-bar h" style="width:92%"></span>
                  <span class="sk-bar h" style="width:68%"></span>
                  <span class="sk-bar" style="width:84%"></span>
                  <span class="sk-bar" style="width:58%"></span>
                  <span class="sk-cta"></span>
                </div>
                <div class="sk-tile"><img src="/assets/emblem-white.png" alt="" width="320" height="320"></div>
              </div>
              <div class="sk-cards">
                <div class="sk-card"><span class="sk-bar" style="width:70%"></span><span class="sk-bar" style="width:46%"></span></div>
                <div class="sk-card"><span class="sk-bar" style="width:62%"></span><span class="sk-bar" style="width:52%"></span></div>
                <div class="sk-card"><span class="sk-bar" style="width:74%"></span><span class="sk-bar" style="width:40%"></span></div>
              </div>
            </div>
          </div>
          <div class="phone">
            <span class="phone-btn pb-silent"></span><span class="phone-btn pb-up"></span><span class="phone-btn pb-down"></span><span class="phone-btn pb-power"></span>
            <div class="phone-screen">
              <span class="phone-island"></span>
              <div class="sk-nav"><span class="sk-logo"></span><span class="sk-bar" style="width:34%"></span></div>
              <span class="sk-bar h" style="width:94%"></span>
              <span class="sk-bar h" style="width:64%"></span>
              <span class="sk-bar" style="width:86%"></span>
              <span class="sk-cta"></span>
              <div class="sk-tile"><img src="/assets/emblem-white.png" alt="" width="320" height="320"></div>
              <div class="sk-card"><span class="sk-bar" style="width:66%"></span></div>
              <div class="sk-card"><span class="sk-bar" style="width:52%"></span></div>
            </div>
          </div>
        </div>
        <p class="draft-note" data-i18n="draft.note">{tx('draft.note')}</p>
      </div>
    </section>
